<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sentiers — carnet de randos du groupe</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#f1efe4; --ink:#1e2621; --pine:#2f4b3c; --pine-dark:#203327;
    --clay:#a15c3e; --contour:#cabf9f; --card-bg:#fbfaf5; --line:#d8d2bd;
    --ok:#3c6e4a; --warn:#a15c3e; --err:#9a3a2a;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0; background:var(--paper);
    background-image:
      repeating-radial-gradient(circle at 15% 20%, transparent 0 26px, rgba(160,148,110,0.10) 27px 28px, transparent 29px 60px),
      repeating-radial-gradient(circle at 85% 75%, transparent 0 40px, rgba(160,148,110,0.08) 41px 42px, transparent 43px 90px);
    color:var(--ink); font-family:'Inter',system-ui,sans-serif; line-height:1.45;
  }
  h1,h2,h3,.brand{font-family:'Fraunces',serif;}
  header.top{padding:18px 28px 14px;border-bottom:2px solid var(--pine);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
  header.top .brand{font-size:26px;font-weight:650;color:var(--pine-dark);}
  header.top .tagline{font-size:13px;color:#5b6b60;margin-left:10px;}
  .top-left{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px;}
  .status-pill{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:#5b6b60;margin-left:14px;}
  .status-pill .dot{width:8px;height:8px;border-radius:50%;background:#9aa39a;}
  .status-pill.ok .dot{background:var(--ok);} .status-pill.syncing .dot{background:var(--clay);animation:pulse 1s infinite;}
  .status-pill.error .dot{background:var(--err);} .status-pill.local .dot{background:#9aa39a;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}
  .top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  button{font-family:inherit;cursor:pointer;border:1.5px solid var(--pine);background:var(--pine);color:#fff;padding:9px 16px;font-size:14px;font-weight:500;border-radius:3px;transition:background .15s,color .15s;}
  button.ghost{background:transparent;color:var(--pine-dark);}
  button.ghost:hover{background:var(--pine);color:#fff;}
  button.subtle{border-color:var(--line);color:#5b6b60;background:transparent;font-size:13px;padding:6px 12px;}
  button.subtle:hover{border-color:var(--clay);color:var(--clay);}
  button.danger{border-color:#8f3b2a;background:transparent;color:#8f3b2a;}
  button.danger:hover{background:#8f3b2a;color:#fff;}
  button:hover{background:var(--pine-dark);}
  button:disabled{opacity:.5;cursor:not-allowed;}
  .banner{margin:14px 28px 0;padding:12px 16px;border:1.5px dashed var(--clay);background:#fbf3ee;font-size:13.5px;color:var(--pine-dark);display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;}
  main{display:grid;grid-template-columns:380px 1fr;gap:0;align-items:start;}
  @media (max-width:860px){ main{grid-template-columns:1fr;} }
  .list-pane{border-right:2px solid var(--line);min-height:70vh;padding:18px 0 60px;}
  .list-header{padding:0 22px 14px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);margin-bottom:6px;}
  .list-header h2{margin:0;font-size:16px;font-weight:650;color:var(--pine-dark);}
  .toggle-past{font-size:13px;color:#5b6b60;display:flex;align-items:center;gap:6px;cursor:pointer;user-select:none;}
  .hike-card{padding:14px 22px;border-bottom:1px solid var(--line);cursor:pointer;}
  .hike-card:hover{background:var(--card-bg);}
  .hike-card.active{background:var(--card-bg);border-left:3px solid var(--clay);}
  .hike-card .titre{font-weight:600;font-size:15px;color:var(--pine-dark);}
  .hike-card .meta{font-size:12.5px;color:#6a7267;margin-top:3px;display:flex;gap:10px;flex-wrap:wrap;}
  .hike-card .route{font-size:13px;margin-top:5px;color:var(--ink);}
  .badge{display:inline-block;font-size:11px;padding:2px 7px;border-radius:2px;background:var(--contour);color:var(--pine-dark);margin-top:6px;}
  .empty-note{padding:26px 22px;color:#6a7267;font-size:14px;}
  .detail-pane{padding:24px 32px 60px;}
  .placeholder{color:#6a7267;padding:60px 10px;text-align:center;font-size:15px;}
  .detail-head h2{margin:0 0 4px;font-size:24px;color:var(--pine-dark);}
  .detail-head .route-line{font-size:15px;color:var(--ink);margin-bottom:10px;}
  .stat-row{display:flex;gap:22px;flex-wrap:wrap;margin:14px 0 18px;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .stat{font-size:13px;color:#5b6b60;}
  .stat b{display:block;font-size:17px;color:var(--pine-dark);font-family:'Fraunces',serif;font-weight:650;}
  #map{height:280px;border:1.5px solid var(--pine);margin:10px 0 20px;}
  .section-title{font-size:14px;font-weight:650;color:var(--pine-dark);margin:22px 0 10px;}
  .participants{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;}
  .pill{background:var(--card-bg);border:1px solid var(--line);padding:5px 12px;border-radius:16px;font-size:13px;display:flex;align-items:center;gap:7px;}
  .pill button{border:none;background:none;color:#a15c3e;padding:0;font-size:14px;line-height:1;}
  .signup-row{display:flex;gap:8px;margin-bottom:4px;}
  .signup-row input{flex:1;}
  input,textarea{font-family:inherit;font-size:14px;padding:8px 10px;border:1.5px solid var(--line);border-radius:3px;background:#fff;color:var(--ink);}
  input:focus,textarea:focus{outline:none;border-color:var(--pine);}
  .comment{border-top:1px dashed var(--line);padding:10px 0;}
  .comment .who{font-size:13px;font-weight:600;color:var(--pine-dark);}
  .comment .when{font-size:11px;color:#8a9186;margin-left:6px;}
  .comment .txt{font-size:14px;margin-top:3px;}
  .comment-form{display:flex;gap:8px;margin-top:12px;}
  .comment-form input:first-child{width:130px;}
  .comment-form input:nth-child(2){flex:1;}
  .modal-backdrop{position:fixed;inset:0;background:rgba(30,38,33,.45);display:none;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;z-index:50;}
  .modal-backdrop.open{display:flex;}
  .modal{background:var(--paper);border:2px solid var(--pine);max-width:540px;width:100%;padding:26px 28px 30px;}
  .modal h3{margin:0 0 6px;color:var(--pine-dark);}
  .modal p.lead{font-size:13px;color:#5b6b60;margin:0 0 16px;}
  .field{margin-bottom:12px;}
  .field label{display:block;font-size:12.5px;color:#5b6b60;margin-bottom:4px;font-weight:500;}
  .field input,.field textarea{width:100%;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  #addMap{height:200px;border:1.5px solid var(--pine);margin-top:8px;}
  .geo-row{display:flex;gap:8px;}
  .geo-row input{flex:1;}
  .modal-actions{display:flex;justify-content:space-between;margin-top:20px;align-items:center;}
  .hint{font-size:12px;color:#8a9186;margin-top:4px;}
  footer{padding:20px 28px 40px;font-size:12.5px;color:#8a9186;border-top:1px solid var(--line);}
  footer a{color:var(--clay);}
  .warn-box{border:1.5px solid var(--err);background:#fbeeeb;color:#7a2c1e;font-size:12.5px;padding:10px 12px;margin:10px 0;}
  .warn-box b{display:block;margin-bottom:2px;}
  .checkline{display:flex;align-items:flex-start;gap:8px;font-size:13px;color:#5b6b60;margin:6px 0 14px;}
  .checkline input{margin-top:3px;}
  .link-output{width:100%;font-family:monospace;font-size:12.5px;margin-top:8px;}
  hr.sep{border:none;border-top:1px solid var(--line);margin:20px 0;}
</style>
</head>
<body>

<header class="top">
  <div class="top-left">
    <span class="brand">Sentiers</span><span class="tagline">carnet de randos du groupe</span>
    <span class="status-pill local" id="statusPill"><span class="dot"></span><span id="statusText">Non configuré</span></span>
  </div>
  <div class="top-actions">
    <button class="subtle" id="btnRefresh" title="Recharger depuis GitHub">⟳ Actualiser</button>
    <button class="subtle" id="btnExport">Exporter JSON</button>
    <button class="subtle" id="btnImport">Importer</button>
    <input type="file" id="fileImport" accept="application/json" style="display:none">
    <button class="subtle" id="btnSettings">⚙ Paramètres</button>
    <button id="btnAdd">+ Proposer une rando</button>
  </div>
</header>

<div class="banner" id="configBanner" style="display:none;">
  <span>Aucun dépôt GitHub configuré — les données restent uniquement dans ce navigateur.</span>
  <button class="ghost" id="btnBannerSettings">Configurer le dépôt GitHub</button>
</div>

<main>
  <section class="list-pane">
    <div class="list-header">
      <h2 id="listTitle">À venir</h2>
      <label class="toggle-past"><input type="checkbox" id="chkPast"> Voir les randos passées</label>
    </div>
    <div id="list"></div>
  </section>
  <section class="detail-pane" id="detail">
    <div class="placeholder">Sélectionnez une rando à gauche, ou proposez-en une nouvelle.</div>
  </section>
</main>

<footer>Les randos sont lues et publiées depuis un dépôt GitHub (fichier JSON) si configuré ci-dessus ; sinon elles restent stockées localement dans ce navigateur.</footer>

<!-- Modale paramètres GitHub -->
<div class="modal-backdrop" id="settingsBackdrop">
  <div class="modal">
    <h3>Paramètres GitHub</h3>
    <p class="lead">Le fichier JSON doit se trouver dans un dépôt <b>public</b> pour que tout le monde puisse le lire sans jeton (cas classique d'un site GitHub Pages).</p>
    <div class="grid2">
      <div class="field"><label>Propriétaire / organisation</label><input id="s_owner" placeholder="ex. jdupont"></div>
      <div class="field"><label>Dépôt</label><input id="s_repo" placeholder="ex. randos-groupe"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Branche</label><input id="s_branch" placeholder="main"></div>
      <div class="field"><label>Chemin du fichier JSON</label><input id="s_path" placeholder="randos.json"></div>
    </div>
    <div class="field">
      <label>Jeton d'accès personnel GitHub (facultatif, pour publier les modifications)</label>
      <input type="password" id="s_token" placeholder="github_pat_… (laisser vide en lecture seule)">
      <div class="hint">Créez un jeton « fine-grained » limité à ce dépôt, avec la permission <i>Contents: Read and write</i>. Il n'est jamais transmis ailleurs qu'à l'API GitHub, et reste stocké uniquement dans ce navigateur.</div>
    </div>
    <div class="warn-box">
      <b>Ne partagez jamais votre jeton dans un message public ou un lien.</b>
      Toute personne qui obtiendrait ce jeton pourrait modifier votre dépôt GitHub. Seules les personnes de confiance chargées de publier des randos devraient en configurer un — transmettez-le en direct, pas via le lien ci-dessous.
    </div>
    <button class="ghost" id="btnSettingsSave" type="button">Enregistrer les paramètres</button>

    <hr class="sep">
    <h3 style="font-size:16px;">Lien à partager au groupe</h3>
    <p class="lead">Génère un lien pré-configuré avec le dépôt/branche/fichier, à envoyer aux participants pour qu'ils ouvrent l'appli directement connectée aux bonnes données.</p>
    <label class="checkline">
      <input type="checkbox" id="s_includeToken">
      Inclure aussi mon jeton dans ce lien (fortement déconseillé — donne un accès en écriture à quiconque ouvre le lien)
    </label>
    <button class="subtle" id="btnGenLink" type="button">Générer et copier le lien</button>
    <input class="link-output" id="s_link" readonly onclick="this.select()">
  </div>
</div>

<!-- Modale ajout -->
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal">
    <h3>Proposer une randonnée</h3>
    <div class="field"><label>Titre</label><input id="f_titre" placeholder="Ex. Boucle des Trois Cols"></div>
    <div class="grid2">
      <div class="field"><label>Organisateur·rice</label><input id="f_orga"></div>
      <div class="field"><label>Date</label><input type="date" id="f_date"></div>
    </div>
    <div class="grid3">
      <div class="field"><label>Heure de départ</label><input type="time" id="f_hdep"></div>
      <div class="field"><label>Heure de retour prévue</label><input type="time" id="f_harr"></div>
      <div class="field"><label>Durée prévue</label><input id="f_duree" placeholder="ex. 4h30"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Distance (km)</label><input type="number" step="0.1" id="f_km"></div>
      <div class="field"><label>Dénivelé (m D+)</label><input type="number" id="f_deniv"></div>
    </div>
    <div class="field"><label>Lieu d'arrivée</label><input id="f_arrivee" placeholder="Ex. Refuge du Lac"></div>
    <div class="field">
      <label>Lieu de départ — recherche d'adresse</label>
      <div class="geo-row">
        <input id="f_adresse" placeholder="Ex. Parking du Col des Aravis, Manigod">
        <button class="subtle" id="btnGeocode" type="button">Localiser</button>
      </div>
      <div class="hint">Ajustez ensuite le repère sur la carte si besoin (glisser-déposer).</div>
      <div id="addMap"></div>
    </div>
    <div class="modal-actions">
      <button class="ghost" id="btnCancel" type="button">Annuler</button>
      <button id="btnSave" type="button">Enregistrer la rando</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const CONFIG_KEY = 'sentiers_gh_config_v1';
const TOKEN_KEY = 'sentiers_gh_token_v1';
const LOCAL_CACHE_KEY = 'sentiers_data_cache_v1';

let state = { hikes: [] };
let selectedId = null;
let showPast = false;
let detailMap = null;
let addMap = null, addMarker = null, addLatLng = null;

// ---------- Config ----------
function getConfig(){
  const cfg = JSON.parse(localStorage.getItem(CONFIG_KEY) || '{}');
  cfg.branch = cfg.branch || 'main';
  cfg.path = cfg.path || 'randos.json';
  cfg.token = localStorage.getItem(TOKEN_KEY) || '';
  return cfg;
}
function saveConfig({owner, repo, branch, path, token}){
  localStorage.setItem(CONFIG_KEY, JSON.stringify({owner: owner||'', repo: repo||'', branch: branch||'main', path: path||'randos.json'}));
  if(token) localStorage.setItem(TOKEN_KEY, token);
  else localStorage.removeItem(TOKEN_KEY);
}
function hasRepo(cfg){ return !!(cfg.owner && cfg.repo); }
function rawUrl(cfg){ return `https://raw.githubusercontent.com/${cfg.owner}/${cfg.repo}/${cfg.branch}/${cfg.path}`; }

function applyUrlConfig(){
  const params = new URLSearchParams(location.search);
  if(params.has('owner') || params.has('repo')){
    saveConfig({
      owner: params.get('owner') || '',
      repo: params.get('repo') || '',
      branch: params.get('branch') || 'main',
      path: params.get('path') || 'randos.json',
      token: params.get('token') || undefined
    });
    history.replaceState(null, '', location.pathname);
  }
}

function updateConfigBanner(){
  const cfg = getConfig();
  document.getElementById('configBanner').style.display = hasRepo(cfg) ? 'none' : 'flex';
}

function setStatus(kind, text){
  const pill = document.getElementById('statusPill');
  pill.className = 'status-pill ' + kind;
  document.getElementById('statusText').textContent = text;
}

// ---------- GitHub read/write ----------
function b64EncodeUnicode(str){
  return btoa(encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, (m,p1)=>String.fromCharCode('0x'+p1)));
}
function b64DecodeUnicode(str){
  return decodeURIComponent(atob(str.replace(/\n/g,'')).split('').map(c=>'%'+('00'+c.charCodeAt(0).toString(16)).slice(-2)).join(''));
}
async function ghGetFile(cfg){
  const res = await fetch(`https://api.github.com/repos/${cfg.owner}/${cfg.repo}/contents/${encodeURIComponent(cfg.path)}?ref=${encodeURIComponent(cfg.branch)}&_=${Date.now()}`, {
    headers: Object.assign({'Accept':'application/vnd.github+json'}, cfg.token ? {Authorization: 'Bearer ' + cfg.token} : {})
  });
  if(res.status === 404) return {data: {hikes: []}, sha: null};
  if(!res.ok) throw new Error('lecture GitHub ' + res.status);
  const json = await res.json();
  const content = b64DecodeUnicode(json.content || '');
  return {data: content ? JSON.parse(content) : {hikes: []}, sha: json.sha};
}
async function ghPutFile(cfg, dataObj, sha, message){
  const body = {message: message || 'Mise à jour randos.json', content: b64EncodeUnicode(JSON.stringify(dataObj, null, 2)), branch: cfg.branch};
  if(sha) body.sha = sha;
  const res = await fetch(`https://api.github.com/repos/${cfg.owner}/${cfg.repo}/contents/${encodeURIComponent(cfg.path)}`, {
    method: 'PUT',
    headers: {Authorization: 'Bearer ' + cfg.token, 'Accept': 'application/vnd.github+json', 'Content-Type': 'application/json'},
    body: JSON.stringify(body)
  });
  if(!res.ok){
    const err = await res.json().catch(()=>({}));
    throw new Error((err.message || ('échec ' + res.status)));
  }
  return res.json();
}

async function initialLoad(){
  const cfg = getConfig();
  updateConfigBanner();
  if(!hasRepo(cfg)){
    const cached = localStorage.getItem(LOCAL_CACHE_KEY);
    state = cached ? JSON.parse(cached) : {hikes: []};
    setStatus('local', 'Non configuré — données locales uniquement');
    renderAll();
    return;
  }
  setStatus('syncing', 'Chargement depuis ' + cfg.owner + '/' + cfg.repo + '…');
  try{
    const res = await fetch(rawUrl(cfg) + '?_=' + Date.now());
    if(res.status === 404) state = {hikes: []};
    else if(res.ok) state = await res.json();
    else throw new Error('HTTP ' + res.status);
    localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(state));
    setStatus(cfg.token ? 'ok' : 'ok', 'Synchronisé avec ' + cfg.owner + '/' + cfg.repo + (cfg.token ? '' : ' (lecture seule)'));
  }catch(e){
    const cached = localStorage.getItem(LOCAL_CACHE_KEY);
    state = cached ? JSON.parse(cached) : {hikes: []};
    setStatus('error', "Impossible de joindre GitHub — dernière copie locale affichée");
  }
  renderAll();
}

async function syncMutate(mutatorFn, message){
  const cfg = getConfig();
  if(!hasRepo(cfg)){
    state = mutatorFn(JSON.parse(JSON.stringify(state)));
    localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(state));
    setStatus('local', 'Enregistré localement — configurez GitHub pour partager au groupe');
    renderAll();
    return;
  }
  if(!cfg.token){
    state = mutatorFn(JSON.parse(JSON.stringify(state)));
    localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(state));
    setStatus('local', 'Enregistré localement seulement — aucun jeton configuré pour publier sur GitHub');
    renderAll();
    return;
  }
  setStatus('syncing', 'Publication sur GitHub…');
  try{
    const {data: remote, sha} = await ghGetFile(cfg);
    const updated = mutatorFn(remote || {hikes: []});
    await ghPutFile(cfg, updated, sha, message);
    state = updated;
    localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(state));
    setStatus('ok', 'Publié sur ' + cfg.owner + '/' + cfg.repo);
  }catch(e){
    state = mutatorFn(JSON.parse(JSON.stringify(state)));
    localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(state));
    setStatus('error', 'Échec de publication (' + e.message + ') — gardé localement seulement');
  }
  renderAll();
}

function renderAll(){ renderList(); renderDetail(); }

// ---------- Rendu ----------
function uid(){ return 'h_' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function endDateTime(h){ const t = h.heureArrivee || h.heureDepart || '23:59'; return new Date(h.date + 'T' + t); }
function isPast(h){ return endDateTime(h).getTime() < Date.now(); }
function fmtDate(d){ const dt = new Date(d + 'T00:00:00'); return dt.toLocaleDateString('fr-FR', {weekday:'short', day:'numeric', month:'short', year:'numeric'}); }
function escapeHtml(s){ return (s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function renderList(){
  const list = document.getElementById('list');
  document.getElementById('listTitle').textContent = showPast ? 'Randos passées' : 'À venir';
  let hikes = (state.hikes||[]).filter(h => showPast ? isPast(h) : !isPast(h));
  hikes.sort((a,b)=>{
    const da = a.date + 'T' + (a.heureDepart||'00:00'), db = b.date + 'T' + (b.heureDepart||'00:00');
    return showPast ? db.localeCompare(da) : da.localeCompare(db);
  });
  if(hikes.length === 0){
    list.innerHTML = `<div class="empty-note">${showPast ? "Aucune rando passée pour l'instant." : "Aucune rando à venir. Proposez-en une !"}</div>`;
    return;
  }
  list.innerHTML = hikes.map(h => `
    <div class="hike-card ${h.id===selectedId?'active':''}" data-id="${h.id}">
      <div class="titre">${escapeHtml(h.titre)}</div>
      <div class="meta"><span>${fmtDate(h.date)}</span><span>${h.heureDepart||'?'}${h.heureArrivee ? ' → '+h.heureArrivee : ''}</span></div>
      <div class="route">${escapeHtml(h.departLabel||'?')} → ${escapeHtml(h.arrivee||'?')}</div>
      <div class="badge">${h.km ?? '?'} km · ${h.deniv ?? '?'} m D+</div>
    </div>`).join('');
  list.querySelectorAll('.hike-card').forEach(el=>{
    el.addEventListener('click', ()=>{ selectedId = el.dataset.id; renderList(); renderDetail(); });
  });
}

function renderDetail(){
  const el = document.getElementById('detail');
  const h = (state.hikes||[]).find(x=>x.id===selectedId);
  if(!h){ el.innerHTML = '<div class="placeholder">Sélectionnez une rando à gauche, ou proposez-en une nouvelle.</div>'; return; }
  el.innerHTML = `
    <div class="detail-head">
      <h2>${escapeHtml(h.titre)}</h2>
      <div class="route-line">${escapeHtml(h.departLabel||'?')} → ${escapeHtml(h.arrivee||'?')} · organisée par ${escapeHtml(h.orga||'?')}</div>
    </div>
    <div class="stat-row">
      <div class="stat"><b>${fmtDate(h.date)}</b>date</div>
      <div class="stat"><b>${h.heureDepart||'?'}${h.heureArrivee?' – '+h.heureArrivee:''}</b>horaires</div>
      <div class="stat"><b>${h.duree||'?'}</b>durée prévue</div>
      <div class="stat"><b>${h.km ?? '?'} km</b>distance</div>
      <div class="stat"><b>${h.deniv ?? '?'} m</b>dénivelé D+</div>
    </div>
    <div id="map"></div>
    <div class="section-title">Participants (${(h.participants||[]).length})</div>
    <div class="participants" id="participantsList"></div>
    <div class="signup-row">
      <input id="signupName" placeholder="Votre prénom">
      <button class="subtle" id="btnSignup" type="button">S'inscrire</button>
    </div>
    <div class="section-title">Discussion</div>
    <div id="commentsList"></div>
    <div class="comment-form">
      <input id="commentAuthor" placeholder="Prénom">
      <input id="commentText" placeholder="Un message pour le groupe…">
      <button class="subtle" id="btnComment" type="button">Envoyer</button>
    </div>
    <div style="margin-top:24px;"><button class="danger" id="btnDelete" type="button">Supprimer cette rando</button></div>
  `;
  renderParticipants(h);
  renderComments(h);
  document.getElementById('btnSignup').onclick = ()=>{
    const name = document.getElementById('signupName').value.trim();
    if(!name) return;
    syncMutate(s=>{ const hh=s.hikes.find(x=>x.id===h.id); if(hh){ hh.participants=hh.participants||[]; if(!hh.participants.includes(name)) hh.participants.push(name);} return s; }, `Inscription de ${name} — ${h.titre}`);
  };
  document.getElementById('btnComment').onclick = ()=>{
    const author = document.getElementById('commentAuthor').value.trim();
    const text = document.getElementById('commentText').value.trim();
    if(!author || !text) return;
    syncMutate(s=>{ const hh=s.hikes.find(x=>x.id===h.id); if(hh){ hh.comments=hh.comments||[]; hh.comments.push({author, text, at: new Date().toISOString()}); } return s; }, `Commentaire de ${author} — ${h.titre}`);
  };
  document.getElementById('btnDelete').onclick = ()=>{
    if(!confirm('Supprimer définitivement cette rando ?')) return;
    syncMutate(s=>{ s.hikes = s.hikes.filter(x=>x.id!==h.id); return s; }, `Suppression — ${h.titre}`);
    selectedId = null;
  };
  if(detailMap){ detailMap.remove(); detailMap = null; }
  if(h.lat && h.lon){
    detailMap = L.map('map').setView([h.lat, h.lon], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution: '&copy; contributeurs OpenStreetMap', maxZoom: 18}).addTo(detailMap);
    L.marker([h.lat, h.lon]).addTo(detailMap).bindPopup(escapeHtml(h.departLabel||'Départ')).openPopup();
    setTimeout(()=>detailMap.invalidateSize(), 50);
  } else {
    document.getElementById('map').innerHTML = '<div class="placeholder" style="padding:20px;">Pas de coordonnées de départ enregistrées.</div>';
  }
}

function renderParticipants(h){
  const wrap = document.getElementById('participantsList');
  const parts = h.participants || [];
  if(parts.length===0){ wrap.innerHTML = '<span style="color:#8a9186;font-size:13px;">Personne inscrit pour l\\'instant.</span>'; return; }
  wrap.innerHTML = parts.map(p=>`<span class="pill">${escapeHtml(p)}<button data-name="${escapeHtml(p)}" title="Se désinscrire">✕</button></span>`).join('');
  wrap.querySelectorAll('button').forEach(b=>{
    b.onclick = ()=>{ syncMutate(s=>{ const hh=s.hikes.find(x=>x.id===h.id); if(hh) hh.participants = (hh.participants||[]).filter(x=>x!==b.dataset.name); return s; }, `Désinscription — ${h.titre}`); };
  });
}
function renderComments(h){
  const wrap = document.getElementById('commentsList');
  const comments = h.comments || [];
  if(comments.length===0){ wrap.innerHTML = '<div style="color:#8a9186;font-size:13px;padding:8px 0;">Aucun message pour le moment.</div>'; return; }
  wrap.innerHTML = comments.map(c=>`<div class="comment"><span class="who">${escapeHtml(c.author)}</span><span class="when">${new Date(c.at).toLocaleString('fr-FR')}</span><div class="txt">${escapeHtml(c.text)}</div></div>`).join('');
}

// ---------- Modale ajout ----------
function openModal(){
  document.getElementById('modalBackdrop').classList.add('open');
  ['f_titre','f_orga','f_date','f_hdep','f_harr','f_duree','f_km','f_deniv','f_arrivee','f_adresse'].forEach(id=>document.getElementById(id).value='');
  addLatLng = null;
  setTimeout(()=>{
    if(addMap){ addMap.remove(); addMap=null; }
    addMap = L.map('addMap').setView([46.6, 2.2], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution: '&copy; contributeurs OpenStreetMap', maxZoom: 18}).addTo(addMap);
    addMap.on('click', e=> placeAddMarker(e.latlng.lat, e.latlng.lng));
    addMap.invalidateSize();
  }, 30);
}
function closeModal(){ document.getElementById('modalBackdrop').classList.remove('open'); }
function placeAddMarker(lat, lon){
  addLatLng = {lat, lon};
  if(addMarker) addMap.removeLayer(addMarker);
  addMarker = L.marker([lat,lon], {draggable:true}).addTo(addMap);
  addMarker.on('dragend', ()=>{ const p = addMarker.getLatLng(); addLatLng = {lat:p.lat, lon:p.lng}; });
  addMap.setView([lat,lon], 13);
}
async function geocode(){
  const q = document.getElementById('f_adresse').value.trim();
  if(!q) return;
  const btn = document.getElementById('btnGeocode');
  btn.disabled = true; btn.textContent = 'Recherche…';
  try{
    const res = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(q));
    const data = await res.json();
    if(data && data[0]) placeAddMarker(parseFloat(data[0].lat), parseFloat(data[0].lon));
    else alert("Adresse introuvable, essayez une formulation plus précise ou placez le repère manuellement sur la carte.");
  }catch(e){
    alert("Recherche indisponible (pas de connexion internet ?). Placez le repère manuellement sur la carte.");
  }
  btn.disabled = false; btn.textContent = 'Localiser';
}
async function saveHike(){
  const titre = document.getElementById('f_titre').value.trim();
  const date = document.getElementById('f_date').value;
  if(!titre || !date){ alert('Merci de renseigner au moins un titre et une date.'); return; }
  const h = {
    id: uid(), titre, orga: document.getElementById('f_orga').value.trim(), date,
    heureDepart: document.getElementById('f_hdep').value, heureArrivee: document.getElementById('f_harr').value,
    duree: document.getElementById('f_duree').value.trim(),
    km: parseFloat(document.getElementById('f_km').value) || null,
    deniv: parseInt(document.getElementById('f_deniv').value) || null,
    arrivee: document.getElementById('f_arrivee').value.trim(),
    departLabel: document.getElementById('f_adresse').value.trim(),
    lat: addLatLng ? addLatLng.lat : null, lon: addLatLng ? addLatLng.lon : null,
    participants: [], comments: []
  };
  await syncMutate(s=>{ s.hikes = s.hikes || []; s.hikes.push(h); return s; }, `Nouvelle rando — ${titre}`);
  closeModal();
  selectedId = h.id; showPast = false; document.getElementById('chkPast').checked = false;
  renderAll();
}

// ---------- Export / Import ----------
function exportData(){
  const blob = new Blob([JSON.stringify(state, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'randos-groupe.json'; a.click();
  URL.revokeObjectURL(url);
}
function importData(file){
  const reader = new FileReader();
  reader.onload = async ()=>{
    try{
      const incoming = JSON.parse(reader.result);
      if(!incoming.hikes) throw new Error('format invalide');
      await syncMutate(s=>{
        const ids = new Set((s.hikes||[]).map(h=>h.id));
        const merged = (s.hikes||[]).slice();
        incoming.hikes.forEach(h=>{ if(!ids.has(h.id)) merged.push(h); });
        s.hikes = merged; return s;
      }, 'Import JSON');
      alert('Import réussi : ' + incoming.hikes.length + ' rando(s) dans le fichier, fusionnées.');
    }catch(e){ alert("Ce fichier n'est pas un export valide du carnet de randos."); }
  };
  reader.readAsText(file);
}

// ---------- Paramètres ----------
function openSettings(){
  const cfg = getConfig();
  document.getElementById('s_owner').value = cfg.owner || '';
  document.getElementById('s_repo').value = cfg.repo || '';
  document.getElementById('s_branch').value = cfg.branch || 'main';
  document.getElementById('s_path').value = cfg.path || 'randos.json';
  document.getElementById('s_token').value = cfg.token || '';
  document.getElementById('s_includeToken').checked = false;
  document.getElementById('s_link').value = '';
  document.getElementById('settingsBackdrop').classList.add('open');
}
function readSettingsForm(){
  return {
    owner: document.getElementById('s_owner').value.trim(),
    repo: document.getElementById('s_repo').value.trim(),
    branch: document.getElementById('s_branch').value.trim() || 'main',
    path: document.getElementById('s_path').value.trim() || 'randos.json',
    token: document.getElementById('s_token').value.trim()
  };
}
function buildShareLink(includeToken){
  const cfg = readSettingsForm();
  const params = new URLSearchParams();
  if(cfg.owner) params.set('owner', cfg.owner);
  if(cfg.repo) params.set('repo', cfg.repo);
  params.set('branch', cfg.branch); params.set('path', cfg.path);
  if(includeToken && cfg.token) params.set('token', cfg.token);
  return location.origin + location.pathname + '?' + params.toString();
}

// ---------- Bindings ----------
document.getElementById('btnAdd').onclick = openModal;
document.getElementById('btnCancel').onclick = closeModal;
document.getElementById('btnSave').onclick = saveHike;
document.getElementById('btnGeocode').onclick = geocode;
document.getElementById('btnExport').onclick = exportData;
document.getElementById('btnImport').onclick = ()=>document.getElementById('fileImport').click();
document.getElementById('fileImport').onchange = (e)=>{ if(e.target.files[0]) importData(e.target.files[0]); e.target.value=''; };
document.getElementById('chkPast').onchange = (e)=>{ showPast = e.target.checked; selectedId=null; renderAll(); };
document.getElementById('btnRefresh').onclick = initialLoad;
document.getElementById('btnSettings').onclick = openSettings;
document.getElementById('btnBannerSettings').onclick = openSettings;
document.getElementById('btnSettingsSave').onclick = ()=>{
  saveConfig(readSettingsForm());
  document.getElementById('settingsBackdrop').classList.remove('open');
  initialLoad();
};
document.getElementById('btnGenLink').onclick = ()=>{
  saveConfig(readSettingsForm());
  const link = buildShareLink(document.getElementById('s_includeToken').checked);
  const out = document.getElementById('s_link');
  out.value = link; out.select();
  navigator.clipboard && navigator.clipboard.writeText(link).catch(()=>{});
};

// ---------- Démarrage ----------
applyUrlConfig();
initialLoad();
setInterval(()=>{
  const settingsOpen = document.getElementById('settingsBackdrop').classList.contains('open');
  const modalOpen = document.getElementById('modalBackdrop').classList.contains('open');
  if(!settingsOpen && !modalOpen) initialLoad();
}, 45000);
</script>
